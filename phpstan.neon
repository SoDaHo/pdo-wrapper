parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: .phpstan.cache
    ignoreErrors:
        # The tests read hook payloads and fetched rows, whose types are mixed, as strings for their
        # assertions: a value of a wrong type fails the assertion itself. src/ casts nothing it has not narrowed.
        -
            identifier: cast.string
            path: tests/*
