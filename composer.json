{
  "name": "sodaho/pdo-wrapper",
  "description": "A lightweight PDO wrapper with fluent query builder and CRUD methods for MariaDB",
  "keywords": ["mariadb", "php", "crud", "database", "pdo", "query-builder", "pdo-wrapper"],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "sodaho",
      "homepage": "https://github.com/sodaho"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94"
  },
  "autoload": {
    "psr-4": {
      "Sodaho\\PdoWrapper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sodaho\\PdoWrapper\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:unit": "vendor/bin/phpunit --testsuite Unit",
    "test:contract": "vendor/bin/phpunit --testsuite Contract",
    "test:driver": "vendor/bin/phpunit --testsuite Driver",
    "test:coverage": "vendor/bin/phpunit --coverage-html coverage",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
    "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs:fix": "vendor/bin/php-cs-fixer fix",
    "ci": ["@cs", "@analyse", "@test"]
  }
}
